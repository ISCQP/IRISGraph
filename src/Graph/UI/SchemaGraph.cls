Include %occInclude

/// 图 Schema 关系图 · 由 ^GraphData.Dic 生成的「类 → 关系 → 类」结构图。
/// Graph schema relation diagram - a "class -> relation -> class" structure diagram generated from ^GraphData.Dic.
///
/// 访问：/csp/healthshare/nehr/Graph.UI.SchemaGraph.cls
/// Access: /csp/healthshare/nehr/Graph.UI.SchemaGraph.cls
///       ?prefix=Logistics.   仅显示源类或目标类以该前缀开头的关系（默认全部）
///       ?prefix=Logistics.   only show relations whose source or target class starts with this prefix (default: all)
///
/// 数据来源：^GraphData.Dic(SourceType, Relation, TargetType, Inverse) = PropName
/// Data source: ^GraphData.Dic(SourceType, Relation, TargetType, Inverse) = PropName
///   —— 由 Graph.Object.Base 在各图类编译期生成。节点=类，边=关系（声明类 → 目标类）。
///   -- generated by Graph.Object.Base at compile time of each graph class. Node = class, edge = relation (declaring class -> target class).
///
/// Author: QP
/// Version: 1.0
Class Graph.UI.SchemaGraph Extends %CSP.Page
{

Parameter CONTENTTYPE = "text/html";

Parameter CHARSET = "UTF-8";

/// 页面入口
/// Page entry point
ClassMethod OnPage() As %Status
{
    Set tPrefix = %request.Get("prefix")
    Set tJSON = ..SchemaJSON(tPrefix, .tNC, .tEC)

    Write "<!DOCTYPE html>", !
    Write "<html lang='en'><head><meta charset='UTF-8'>", !
    Write "<meta name='viewport' content='width=device-width, initial-scale=1.0'>", !
    Write "<title>Graph Schema Diagram</title>", !
    Do ##class(Graph.UI.Network).Head()
    Write "<style>", ..CSS(), ##class(Graph.UI.Network).CSS(), "</style></head><body>", !

    Write "<header class='topbar'>"
    Write "<div class='brand'>&#128376; Graph Schema &#183; Class-Relation Map</div>"
    Write "<div class='sub'>Built from ^GraphData.Dic &#183; nodes = classes, edges = relations (declaring class &#8594; target type)</div>"
    Write "</header>", !

    // Filter + KPIs
    Write "<section class='bar'>"
    Write "<form method='get' class='filter'>"
    Write "<label>Class prefix filter</label>"
    Write "<input type='text' name='prefix' value='", ..esc(tPrefix), "' placeholder='e.g. Logistics.'>"
    Write "<button type='submit'>Apply</button>"
    Write "<a class='clear' href='?'>Clear</a>"
    Write "</form>"
    Write "<div class='counts'><span><b>", tNC, "</b> classes</span><span><b>", tEC, "</b> relations</span></div>"
    Write "</section>", !

    Write "<section class='card'>"
    If tEC = 0 {
        Write "<div class='empty'>&#9888; No relations found in ^GraphData.Dic"
        Write:tPrefix'="" " for prefix <b>" _ ..esc(tPrefix) _ "</b>"
        Write ". Make sure graph classes are compiled.</div>"
    } Else {
        Set gopt("height") = "660px"
        Set gopt("legend") = 1
        Do ##class(Graph.UI.Network).Widget("schema", tJSON, .gopt)
    }
    Write "</section>", !

    Write "<footer class='foot'>Schema generated from ^GraphData.Dic &#183; edges point from the declaring class to the related target type &#183; relation name shown on each edge</footer>", !
    Write "</body></html>", !
    Quit $$$OK
}

/// 由 ^GraphData.Dic 构造 schema 图 JSON。
/// Build the schema graph JSON from ^GraphData.Dic.
///   节点：类（id=全类名，label=短类名，group=所属包，title=全类名）
///   nodes: classes (id = full class name, label = short class name, group = owning package, title = full class name)
///   边  ：声明类 -relation-> 目标类（按 源|关系|目标 去重，忽略 inverse 维度）
///   edges: declaring class -relation-> target class (deduplicated by source|relation|target, ignoring the inverse dimension)
///   pPrefix     仅保留源类或目标类以该前缀开头的关系（""=全部）
///   pPrefix     keep only relations whose source or target class starts with this prefix ("" = all)
///   pNodeCount  输出：节点数
///   pNodeCount  output: number of nodes
///   pEdgeCount  输出：边数
///   pEdgeCount  output: number of edges
ClassMethod SchemaJSON(pPrefix As %String = "", Output pNodeCount, Output pEdgeCount) As %String
{
    Set tG = {}, tNodes = [], tEdges = []
    Kill tSeenN, tSeenE
    Set pNodeCount = 0, pEdgeCount = 0
    Set tPL = $Length(pPrefix)

    Set tSrc = ""
    For 
    {
        Set tSrc = $Order(^GraphData.Dic(tSrc))
        Quit:tSrc=""
        Set tRel = ""
        For 
        {
            Set tRel = $Order(^GraphData.Dic(tSrc, tRel))
            Quit:tRel=""
            Set tTgt = ""
            For 
            {
                Set tTgt = $Order(^GraphData.Dic(tSrc, tRel, tTgt))
                Quit:tTgt=""
                If pPrefix '= "" 
                {
                    Continue:(($Extract(tSrc, 1, tPL) '= pPrefix) && ($Extract(tTgt, 1, tPL) '= pPrefix))
                }
                Do ..node(tSrc, .tSeenN, tNodes, .pNodeCount)
                Do ..node(tTgt, .tSeenN, tNodes, .pNodeCount)
                Set tEK = tSrc _ "|" _ tRel _ "|" _ tTgt
                Continue:$Data(tSeenE(tEK))
                Set tSeenE(tEK) = 1
                Set tE = {}
                Set tE.from = tSrc, tE.to = tTgt, tE.label = tRel
                Do tEdges.%Push(tE)
                Set pEdgeCount = pEdgeCount + 1
            }
        }
    }
    Set tG.nodes = tNodes, tG.edges = tEdges
    Quit tG.%ToJSON()
}

/// 追加去重类节点
/// Append a deduplicated class node
ClassMethod node(pCls As %String, ByRef pSeen, pNodes As %DynamicArray, ByRef pCount)
{
    Quit:pCls=""
    Quit:$Data(pSeen(pCls))
    Set pSeen(pCls) = 1
    Set tParts = $Length(pCls, ".")
    Set tN = {}
    Set tN.id = pCls
    Set tN.label = $Piece(pCls, ".", *)
    Set tN.group = $Select(tParts > 1: $Piece(pCls, ".", tParts - 1), 1: pCls)
    Set tN.title = pCls
    Do pNodes.%Push(tN)
    Set pCount = pCount + 1
}

/// HTML 转义
/// HTML escaping
ClassMethod esc(pText As %String) As %String
{
    Quit $ZCONVERT(pText, "O", "HTML")
}

/// 页面样式
/// Page styles
ClassMethod CSS() As %String
{
    Quit "*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'PingFang SC','Microsoft YaHei',sans-serif;background:#f1f5f9;color:#0f172a}"
     _ ".topbar{background:linear-gradient(90deg,#0f172a,#1e293b);color:#fff;padding:16px 28px}"
     _ ".brand{font-size:20px;font-weight:700}.sub{color:#94a3b8;font-size:13px;margin-top:2px}"
     _ ".bar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:20px 24px 0;flex-wrap:wrap}"
     _ ".filter{display:flex;align-items:center;gap:8px}"
     _ ".filter label{font-size:13px;color:#475569}"
     _ ".filter input{border:1px solid #cbd5e1;border-radius:8px;padding:7px 12px;font-size:13px;min-width:220px}"
     _ ".filter button{border:0;background:#4f46e5;color:#fff;border-radius:8px;padding:8px 16px;font-size:13px;cursor:pointer}"
     _ ".filter button:hover{background:#4338ca}"
     _ ".filter .clear{font-size:13px;color:#64748b;text-decoration:none;padding:8px 6px}.filter .clear:hover{color:#334155}"
     _ ".counts{display:flex;gap:18px;font-size:13px;color:#475569}.counts b{color:#1e293b;font-size:16px}"
     _ ".card{background:#fff;border-radius:14px;padding:20px 24px;margin:16px 24px 20px;box-shadow:0 1px 6px rgba(0,0,0,.06)}"
     _ ".empty{color:#94a3b8;font-size:14px;padding:30px;text-align:center}"
     _ ".foot{text-align:center;color:#94a3b8;font-size:12px;padding:10px 24px 30px}"
}

}
