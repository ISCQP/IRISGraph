/// 波斯湾（霍尔木兹海峡）航运风险影响追踪 · 图谱演示 + 测试
/// Persian Gulf (Strait of Hormuz) shipping risk impact tracing · graph demo + test
/// 
/// 场景：霍尔木兹海峡发生地缘冲突（RiskEvent），影响流经该海峡的航段（RouteSegment）；
/// Scenario: a geopolitical conflict (RiskEvent) occurs in the Strait of Hormuz, affecting the RouteSegment passing through the strait;
/// AI 计算出影响节点（Impact：延误），并传播到货运 / 采购单 / 供应商。
/// AI computes the impact node (Impact: delay) and propagates it to shipment / purchase order / supplier.
/// 本类构造测试数据（边由 Graph.Object.Index 功能索引在 %Save 时自动维护），
/// This class builds test data (edges are automatically maintained by the Graph.Object.Index functional index at %Save time),
/// 再用 Graph.Tools 做单跳 / 多跳 / BFS 追踪，最后以断言验证影响范围。
/// then uses Graph.Tools for single-hop / multi-hop / BFS tracing, and finally verifies the impact scope with assertions.
/// 
/// 场景数据（边由 Graph.Object.Index 功能索引在 %Save 时自动生成）：霍尔木兹海峡地缘冲突 RiskEvent → 影响航段 → AI 计算 Impact(延误120h) → 传播到货运/采购单/供应商；并设了一条绕行好望角的对照货运 SHP-2。
/// Scenario data (edges auto-generated by the Graph.Object.Index functional index at %Save time): Strait of Hormuz geopolitical conflict RiskEvent → affected segment → AI computes Impact(delay 120h) → propagates to shipment/purchase order/supplier; a control shipment SHP-2 detouring via the Cape of Good Hope is also created.
/// 图追踪（用 Graph.Tools）展示的影响链：
/// Impact chain shown by graph tracing (using Graph.Tools):
/// [1] SingleHop affects_segment → 霍尔木兹航段
/// [1] SingleHop affects_segment → Strait of Hormuz segment
/// [2/3/4] MultiHop causes → impact_affects_* → 受影响货运 SHP-1、采购单 PO-1001、供应商 Gulf Petrochem
/// [2/3/4] MultiHop causes → impact_affects_* → affected shipment SHP-1, purchase order PO-1001, supplier Gulf Petrochem
/// [5] 反向 MultiHop（Route←Voyage←Vessel←Container←Shipment）→ 物理途经该航段的货运 SHP-1（正确排除绕行的 SHP-2）
/// [5] Reverse MultiHop (Route←Voyage←Vessel←Container←Shipment) → shipment SHP-1 that physically transits this segment (correctly excluding the detouring SHP-2)
/// [6] BFS → 从风险出发的完整影响子图
/// [6] BFS → the complete impact subgraph starting from the risk
/// 测试用例：T1 风险→航段、T2 →货运、T3 →采购单、T4 →供应商、T5a 途经含 SHP-1、T5b 途经不含 SHP-2 —— 全部 PASS。
/// Test cases: T1 risk→segment, T2 →shipment, T3 →purchase order, T4 →supplier, T5a transit includes SHP-1, T5b transit excludes SHP-2 —— all PASS.
/// 
/// 用法：
/// Usage:
///     Do ##class(Logistics.Test.PersianGulfDemo).Run()      // 建数据 + 追踪 + 断言
///     Do ##class(Logistics.Test.PersianGulfDemo).Run()      // Build data + trace + assert
///     Do ##class(Logistics.Test.PersianGulfDemo).Setup()    // 仅建数据
///     Do ##class(Logistics.Test.PersianGulfDemo).Setup()    // Build data only
///     Do ##class(Logistics.Test.PersianGulfDemo).Trace()    // 仅追踪（需先 Setup）
///     Do ##class(Logistics.Test.PersianGulfDemo).Trace()    // Trace only (requires Setup first)
///     Do ##class(Logistics.Test.PersianGulfDemo).Cleanup()  // 清除测试数据
///     Do ##class(Logistics.Test.PersianGulfDemo).Cleanup()  // Remove test data
/// Author: QP
/// Version: 1.0
Class Logistics.Test.PersianGulfDemo Extends %RegisteredObject
{

/// 一键运行：清理 → 建数据 → 图追踪 → 断言
/// One-click run: cleanup → build data → graph tracing → assert
ClassMethod Run() As %Status
{
    Set tSC = ..Setup()
    If $$$ISERR(tSC) {
        Write !,"Setup 失败: ",$System.Status.GetOneErrorText(tSC),!
        Quit tSC
    }
    Do ..Trace()
    Quit ..Assert()
}

/// 保存对象：登记到 ^LogiDemo 以便清理，返回 OID = $LB(Id, ClassName)
/// Save the object: register into ^LogiDemo for later cleanup, return OID = $LB(Id, ClassName)
ClassMethod save(pObj) As %List
{
    Set tSC = pObj.%Save()
    If $$$ISERR(tSC) $$$ThrowStatus(tSC)
    Set tCls = $ClassName(pObj), tId = pObj.%Id()
    Set ^LogiDemo("obj", tCls, tId) = ""
    Quit $ListBuild(tId, tCls)
}

/// 构造基线数据（业务/物流/地理/航线/货运/采购单，不含风险）
/// Build baseline data (business/logistics/geography/route/shipment/purchase order, without risk)
ClassMethod SetupBaseline() As %Status
{
    Set tSC = $$$OK
    Try {
        Do ..Cleanup()

        // ---------- 地理 Geography ----------
        // ---------- Geography ----------
        Set uae = ##class(Logistics.Geography.Location).%New(), uae.Name = "United Arab Emirates", uae.Type = "Country"
        Do ..save(uae)
        Set gulf = ##class(Logistics.Geography.Location).%New(), gulf.Name = "Persian Gulf", gulf.Type = "SeaArea"
        Do ..save(gulf)
        Set hormuz = ##class(Logistics.Geography.Location).%New(), hormuz.Name = "Strait of Hormuz", hormuz.Type = "SeaArea"
        Do ..save(hormuz)
        Set cape = ##class(Logistics.Geography.Location).%New(), cape.Name = "Cape of Good Hope", cape.Type = "SeaArea"
        Do ..save(cape)
        Set shanghai = ##class(Logistics.Geography.Location).%New(), shanghai.Name = "Shanghai Port", shanghai.Type = "Port"
        Do ..save(shanghai)
        Set rotterdam = ##class(Logistics.Geography.Location).%New(), rotterdam.Name = "Rotterdam Port", rotterdam.Type = "Port"
        Do ..save(rotterdam)
        Set jebelAli = ##class(Logistics.Geography.Location).%New(), jebelAli.Name = "Jebel Ali Port", jebelAli.Type = "Port", jebelAli.LocatedIn = uae
        Do jebelAli.ConnectedTo.Insert(gulf)
        Do ..save(jebelAli)

        // ---------- 政策 / 商品 Policy ----------
        // ---------- Policy / Product ----------
        Set hs = ##class(Logistics.Policy.HSCode).%New(), hs.Code = "2901", hs.Description = "Ethylene (acyclic hydrocarbons)"
        Do ..save(hs)

        // ---------- 业务 Business ----------
        // ---------- Business ----------
        Set supplier = ##class(Logistics.Business.Supplier).%New()
        Set supplier.SupplierCode = "SUP-GP", supplier.Name = "Gulf Petrochem", supplier.Country = uae, supplier.Tier = 1, supplier.Industry = "Petrochemical", supplier.RiskScore = 0.72
        Do ..save(supplier)

        Set product = ##class(Logistics.Business.Product).%New()
        Set product.SKU = "ETH-001", product.Name = "Ethylene", product.HSCode = hs, product.Supplier = supplier
        Do ..save(product)

        // ---------- 航路 Route ----------
        // ---------- Route ----------
        Set routeAE = ##class(Logistics.Route.Route).%New(), routeAE.RouteID = "R-AE-01", routeAE.RouteName = "Asia-Europe via Hormuz"
        Do ..save(routeAE)
        Set routeAlt = ##class(Logistics.Route.Route).%New(), routeAlt.RouteID = "R-ALT-01", routeAlt.RouteName = "Asia-Europe via Cape"
        Do ..save(routeAlt)

        Set hormuzSeg = ##class(Logistics.Route.RouteSegment).%New()
        Set hormuzSeg.SegmentID = "SEG-HORMUZ", hormuzSeg.Name = "Strait of Hormuz Segment", hormuzSeg.Route = routeAE, hormuzSeg.StartLocation = gulf, hormuzSeg.EndLocation = hormuz
        Do hormuzSeg.PassesThrough.Insert(gulf), hormuzSeg.PassesThrough.Insert(hormuz)
        Do ..save(hormuzSeg)

        Set capeSeg = ##class(Logistics.Route.RouteSegment).%New()
        Set capeSeg.SegmentID = "SEG-CAPE", capeSeg.Name = "Cape of Good Hope Segment", capeSeg.Route = routeAlt, capeSeg.StartLocation = cape, capeSeg.EndLocation = cape
        Do capeSeg.PassesThrough.Insert(cape)
        Do ..save(capeSeg)

        // ---------- 运输资产 / 航次 Transport ----------
        // ---------- Transport assets / Voyage ----------
        Set vessel1 = ##class(Logistics.Transport.Vessel).%New()
        Set vessel1.AssetID = "V-GULFSTAR", vessel1.Name = "MV Gulf Star", vessel1.IMO = "IMO1111111", vessel1.CurrentLocation = hormuz
        Do ..save(vessel1)
        Set vessel2 = ##class(Logistics.Transport.Vessel).%New()
        Set vessel2.AssetID = "V-CAPERUN", vessel2.Name = "MV Cape Runner", vessel2.IMO = "IMO2222222", vessel2.CurrentLocation = cape
        Do ..save(vessel2)

        Set voyage1 = ##class(Logistics.Route.Voyage).%New()
        Set voyage1.VoyageNo = "V-001", voyage1.Carrier = "OceanLine", voyage1.Vessel = vessel1, voyage1.Route = routeAE
        Do ..save(voyage1)
        Set voyage2 = ##class(Logistics.Route.Voyage).%New()
        Set voyage2.VoyageNo = "V-002", voyage2.Carrier = "OceanLine", voyage2.Vessel = vessel2, voyage2.Route = routeAlt
        Do ..save(voyage2)

        // ---------- 货运 / 集装箱 Shipment ----------
        // ---------- Shipment / Container ----------
        Set shp1 = ##class(Logistics.Transport.Shipment).%New()
        Set shp1.ShipmentNo = "SHP-1", shp1.Mode = "Sea", shp1.Origin = shanghai, shp1.Destination = rotterdam, shp1.Status = "InTransit"
        Do ..save(shp1)
        Set shp2 = ##class(Logistics.Transport.Shipment).%New()
        Set shp2.ShipmentNo = "SHP-2", shp2.Mode = "Sea", shp2.Origin = shanghai, shp2.Destination = rotterdam, shp2.Status = "InTransit"
        Do ..save(shp2)

        Set cont1 = ##class(Logistics.Asset.Container).%New()
        Set cont1.ContainerNo = "CONT-1", cont1.ISOCode = "42G1", cont1.Shipment = shp1, cont1.CurrentTransport = vessel1
        Do ..save(cont1)
        Set cont2 = ##class(Logistics.Asset.Container).%New()
        Set cont2.ContainerNo = "CONT-2", cont2.ISOCode = "42G1", cont2.Shipment = shp2, cont2.CurrentTransport = vessel2
        Do ..save(cont2)

        Set leg1 = ##class(Logistics.Transport.TransportLeg).%New()
        Set leg1.LegNo = 1, leg1.Mode = "Sea", leg1.Shipment = shp1, leg1.Asset = vessel1, leg1.StartLocation = shanghai, leg1.EndLocation = rotterdam, leg1.Status = "Active"
        Do ..save(leg1)

        // ---------- 采购单 PurchaseOrder ----------
        // ---------- PurchaseOrder ----------
        Set po1 = ##class(Logistics.Business.PurchaseOrder).%New()
        Set po1.PONumber = "PO-1001", po1.Status = "Open", po1.Shipment = shp1
        Do po1.Products.Insert(product)
        Do ..save(po1)

        // ---------- 记录关键基线节点（供触发风险时复用）----------
        // ---------- Record key baseline nodes (reused when triggering risk) ----------
        Set ^LogiDemo("key", "segment") = $ListBuild(hormuzSeg.%Id(), $ClassName(hormuzSeg))
        Set ^LogiDemo("key", "shipment") = $ListBuild(shp1.%Id(), $ClassName(shp1))
        Set ^LogiDemo("key", "po") = $ListBuild(po1.%Id(), $ClassName(po1))
        Set ^LogiDemo("key", "supplier") = $ListBuild(supplier.%Id(), $ClassName(supplier))
        Kill ^LogiDemo("key", "risk")

        Write "基线数据构造完成。",!
    }
    Catch ex {
        Set tSC = ex.AsStatus()
        Write !,"SetupBaseline 异常: ",$System.Status.GetOneErrorText(tSC),!
    }
    Quit tSC
}

/// 全量构造：基线 + 触发 Hormuz 风险（保持原有 Run / ?action=setup 行为）
/// Full construction: baseline + trigger Hormuz risk (preserves original Run / ?action=setup behavior)
ClassMethod Setup() As %Status
{
    Set tSC = ..SetupBaseline()
    Quit:$$$ISERR(tSC) tSC
    Quit ..TriggerHormuzRisk()
}

/// 触发「Hormuz Tension」风险：生成 RiskEvent + RouteImpact + Impact 并保存（图边自动维护）
/// Trigger the "Hormuz Tension" risk: create and save RiskEvent + RouteImpact + Impact (graph edges auto-maintained)
ClassMethod TriggerHormuzRisk() As %Status
{
    Set tSC = $$$OK
    Try {
        // 基线不存在则先构造
        // Build the baseline first if it does not exist
        If $Get(^LogiDemo("key", "segment")) = "" { Do ..SetupBaseline() }
        // 清除上一次触发的风险，保证可重复触发
        // Clear the previously triggered risk to allow repeatable triggering
        Do ..ClearRisk()

        Set hormuzSeg = ##class(Logistics.Route.RouteSegment).%OpenId($ListGet($Get(^LogiDemo("key", "segment")), 1))
        Set shp1 = ##class(Logistics.Transport.Shipment).%OpenId($ListGet($Get(^LogiDemo("key", "shipment")), 1))
        Set po1 = ##class(Logistics.Business.PurchaseOrder).%OpenId($ListGet($Get(^LogiDemo("key", "po")), 1))
        Set supplier = ##class(Logistics.Business.Supplier).%OpenId($ListGet($Get(^LogiDemo("key", "supplier")), 1))
        Set hormuz = $Select($IsObject(hormuzSeg): hormuzSeg.EndLocation, 1: "")

        Set risk = ##class(Logistics.Risk.RiskEvent).%New()
        Set risk.Name = "Hormuz Tension 2026", risk.Type = "War", risk.Severity = 8, risk.Forecast = "Escalation closing the strait for 2 weeks"
        Set:$IsObject(hormuz) risk.Location = hormuz
        Do:$IsObject(hormuzSeg) risk.AffectedSegments.Insert(hormuzSeg)
        Do ..save(risk)

        Set ri = ##class(Logistics.Risk.RouteImpact).%New()
        Set ri.RiskEvent = risk, ri.RouteSegment = hormuzSeg, ri.Severity = 8
        Do ..save(ri)

        Set imp = ##class(Logistics.Impact.Impact).%New()
        Set imp.Type = "Delay", imp.DelayHours = 120, imp.Probability = 0.8, imp.Severity = 8
        Set imp.Description = "Hormuz closure delays Gulf-origin shipment"
        Set imp.Cause = risk, imp.AffectedShipment = shp1, imp.AffectedPO = po1, imp.AffectedSupplier = supplier
        Do ..save(imp)

        Set ^LogiDemo("key", "risk") = $ListBuild(risk.%Id(), $ClassName(risk))
        Write "Hormuz Tension 风险已触发。",!
    }
    Catch ex {
        Set tSC = ex.AsStatus()
        Write !,"TriggerHormuzRisk 异常: ", $System.Status.GetOneErrorText(tSC),!
    }
    Quit tSC
}

/// 清除当前风险（Impact / RouteImpact / RiskEvent），保留基线数据
/// Clear the current risk (Impact / RouteImpact / RiskEvent), keeping the baseline data
ClassMethod ClearRisk() As %Status
{
    Set tSC = $$$OK
    Try {
        For tCls = "Logistics.Impact.Impact", "Logistics.Risk.RouteImpact", "Logistics.Risk.RiskEvent" {
            Set tId = ""
            For {
                Set tId = $Order(^LogiDemo("obj", tCls, tId))
                Quit:tId=""
                Try { Do $ClassMethod(tCls, "%DeleteId", tId)  Kill ^LogiDemo("obj", tCls, tId) } Catch {}
            }
        }
        Kill ^LogiDemo("key", "risk")
    } Catch ex { Set tSC = ex.AsStatus() }
    Quit tSC
}

/// 把节点 OID 渲染成可读标签
/// Render a node OID into a readable label
ClassMethod Label(pOID As %List) As %String
{
    Set tId = $ListGet(pOID, 1), tCls = $ListGet(pOID, 2), tShort = $Piece(tCls, ".", *)
    Set tKey = ""
    Try {
        Set tObj = $ClassMethod(tCls, "%OpenId", tId)
        If $IsObject(tObj) {
            If tShort = "RiskEvent" { Set tKey = tObj.Name_" ["_tObj.Type_"]" }
            ElseIf tShort = "RouteSegment" { Set tKey = tObj.Name }
            ElseIf tShort = "Route" { Set tKey = tObj.RouteName }
            ElseIf tShort = "Voyage" { Set tKey = tObj.VoyageNo }
            ElseIf tShort = "Vessel" { Set tKey = tObj.Name_"("_tObj.IMO_")" }
            ElseIf tShort = "Location" { Set tKey = tObj.Name_"/"_tObj.Type }
            ElseIf tShort = "Shipment" { Set tKey = tObj.ShipmentNo }
            ElseIf tShort = "Container" { Set tKey = tObj.ContainerNo }
            ElseIf tShort = "TransportLeg" { Set tKey = "Leg#"_tObj.LegNo }
            ElseIf tShort = "PurchaseOrder" { Set tKey = tObj.PONumber }
            ElseIf tShort = "Product" { Set tKey = tObj.SKU_" "_tObj.Name }
            ElseIf tShort = "Supplier" { Set tKey = tObj.Name }
            ElseIf tShort = "HSCode" { Set tKey = tObj.Code }
            ElseIf tShort = "Impact" { Set tKey = tObj.Type_" "_tObj.DelayHours_"h" }
            ElseIf tShort = "RouteImpact" { Set tKey = "Sev"_tObj.Severity }
        }
    } Catch { Set tKey = "" }
    Quit tShort_"#"_tId_$Select(tKey="":"", 1:" ("_tKey_")")
}

/// 打印一组节点（从 hop 结果中取终点 OID）
/// Print a set of nodes (take the endpoint OID from the hop result)
/// pUseSource=1 时取 hop.OID（反向多跳的终点），否则取 hop.TargetOID
/// When pUseSource=1 take hop.OID (endpoint of a reverse multi-hop), otherwise take hop.TargetOID
ClassMethod printHops(pResult As %DynamicArray, pUseSource As %Boolean = 0)
{
    For i = 1:1:pResult.%Size() {
        Set tHop = pResult.%Get(i - 1)
        Set tOID = $Select(pUseSource: tHop.OID, 1: tHop.TargetOID)
        Write "      - ", ..Label(tOID), !
    }
}

/// 图追踪：展示波斯湾风险对物流的影响
/// Graph tracing: show the impact of the Persian Gulf risk on logistics
ClassMethod Trace() As %Status
{
    Set tRisk = $Get(^LogiDemo("key", "risk"))
    Set tSeg = $Get(^LogiDemo("key", "segment"))
    If tRisk = "" { Write "请先运行 Setup()。",! Quit $$$OK }

    Write !, "=====================================================", !
    Write "  波斯湾航运风险影响追踪 (Persian Gulf Risk Tracing)", !
    Write "=====================================================", !
    Write "起点风险: ", ..Label(tRisk), !

    // [1] 直接受影响的航段：Risk -affects_segment-> Segment
    // [1] Directly affected segment: Risk -affects_segment-> Segment
    Do ##class(Graph.Tools).SingleHop(tRisk, "affects_segment", 0, .tR)
    Write !, "[1] 直接影响的航段 (affects_segment):", !
    Do ..printHops(.tR, 0)

    // [2] 受影响的货运：Risk -causes-> Impact -impact_affects_shipment-> Shipment
    // [2] Affected shipment: Risk -causes-> Impact -impact_affects_shipment-> Shipment
    Do ##class(Graph.Tools).MultiHop(tRisk, [{"Relation":"causes","Inverse":0}, {"Relation":"impact_affects_shipment","Inverse":0}], .tR)
    Write !, "[2] 受影响的货运 (causes -> impact_affects_shipment):", !
    Do ..printHops(.tR, 0)

    // [3] 受影响的采购单：Risk -causes-> Impact -impact_affects_po-> PO
    // [3] Affected purchase order: Risk -causes-> Impact -impact_affects_po-> PO
    Do ##class(Graph.Tools).MultiHop(tRisk, [{"Relation":"causes","Inverse":0}, {"Relation":"impact_affects_po","Inverse":0}], .tR)
    Write !, "[3] 受影响的采购单 (causes -> impact_affects_po):", !
    Do ..printHops(.tR, 0)

    // [4] 受影响的供应商：Risk -causes-> Impact -impact_affects_supplier-> Supplier
    // [4] Affected supplier: Risk -causes-> Impact -impact_affects_supplier-> Supplier
    Do ##class(Graph.Tools).MultiHop(tRisk, [{"Relation":"causes","Inverse":0}, {"Relation":"impact_affects_supplier","Inverse":0}], .tR)
    Write !, "[4] 受影响的供应商 (causes -> impact_affects_supplier):", !
    Do ..printHops(.tR, 0)

    // [5] 物理途经霍尔木兹航段的货运（反向多跳）
    // [5] Shipments physically transiting the Strait of Hormuz segment (reverse multi-hop)
    //     Segment <-route_contains_segment- Route <-uses- Voyage <-assigned_to- Vessel <-loaded_on- Container <-contains- Shipment
    Do ##class(Graph.Tools).MultiHop(tSeg, [{"Relation":"route_contains_segment","Inverse":1}, {"Relation":"uses","Inverse":1}, {"Relation":"assigned_to","Inverse":1}, {"Relation":"loaded_on","Inverse":1}, {"Relation":"contains","Inverse":1}], .tR)
    Write !, "[5] 物理途经该航段的货运 (Route<-Voyage<-Vessel<-Container<-Shipment):", !
    Do ..printHops(.tR, 1)

    // [6] 影响子图全景（BFS，双向，深度<=3）
    // [6] Full impact subgraph (BFS, bidirectional, depth<=3)
    Do ##class(Graph.Tools).BFS(tRisk, 3, .tR)
    Write !, "[6] 影响子图全景 (BFS depth<=3):", !
    For i = 1:1:tR.%Size() {
        Set tHop = tR.%Get(i - 1)
        Write "      ", ..Label(tHop.OID), "  --", tHop.Relation, "-->  ", ..Label(tHop.TargetOID), !
    }
    Quit $$$OK
}

/// 断言测试用例：验证影响范围符合预期
/// Assertion test cases: verify the impact scope matches expectations
ClassMethod Assert() As %Status
{
    Set tRisk = $Get(^LogiDemo("key", "risk")), tSeg = $Get(^LogiDemo("key", "segment"))
    Set tPass = 1, tMsg = ""
    Write !, "----------------- 测试用例 -----------------", !

    // T1: 风险直接影响霍尔木兹航段
    // T1: risk directly affects the Strait of Hormuz segment
    Do ##class(Graph.Tools).SingleHop(tRisk, "affects_segment", 0, .tR)
    Set tHit = ..contains(.tR, 0, "Strait of Hormuz Segment")
    Do ..report("T1 风险影响霍尔木兹航段", tHit, .tPass)

    // T2: 影响传播到货运 SHP-1
    // T2: impact propagates to shipment SHP-1
    Do ##class(Graph.Tools).MultiHop(tRisk, [{"Relation":"causes","Inverse":0}, {"Relation":"impact_affects_shipment","Inverse":0}], .tR)
    Do ..report("T2 影响传播到货运 SHP-1", ..contains(.tR, 0, "SHP-1"), .tPass)

    // T3: 影响传播到采购单 PO-1001
    // T3: impact propagates to purchase order PO-1001
    Do ##class(Graph.Tools).MultiHop(tRisk, [{"Relation":"causes","Inverse":0}, {"Relation":"impact_affects_po","Inverse":0}], .tR)
    Do ..report("T3 影响传播到采购单 PO-1001", ..contains(.tR, 0, "PO-1001"), .tPass)

    // T4: 影响传播到供应商 Gulf Petrochem
    // T4: impact propagates to supplier Gulf Petrochem
    Do ##class(Graph.Tools).MultiHop(tRisk, [{"Relation":"causes","Inverse":0}, {"Relation":"impact_affects_supplier","Inverse":0}], .tR)
    Do ..report("T4 影响传播到供应商 Gulf Petrochem", ..contains(.tR, 0, "Gulf Petrochem"), .tPass)

    // T5: 物理途经航段的货运含 SHP-1，但不含绕行好望角的 SHP-2
    // T5: shipments physically transiting the segment include SHP-1 but exclude the Cape-of-Good-Hope-detouring SHP-2
    Do ##class(Graph.Tools).MultiHop(tSeg, [{"Relation":"route_contains_segment","Inverse":1}, {"Relation":"uses","Inverse":1}, {"Relation":"assigned_to","Inverse":1}, {"Relation":"loaded_on","Inverse":1}, {"Relation":"contains","Inverse":1}], .tR)
    Do ..report("T5a 途经航段货运含 SHP-1", ..contains(.tR, 1, "SHP-1"), .tPass)
    Do ..report("T5b 途经航段货运不含 SHP-2（绕行好望角）", '..contains(.tR, 1, "SHP-2"), .tPass)

    Write "--------------------------------------------", !
    Write $Select(tPass: ">>> 全部测试通过 (ALL PASSED)", 1: ">>> 存在失败用例 (FAILED)"), !
    Quit $Select(tPass: $$$OK, 1: $$$ERROR(5001, "PersianGulfDemo 测试存在失败用例"))
}

/// 判断 hop 结果中是否有某标签的节点
/// Check whether the hop result contains a node with a given label
ClassMethod contains(pResult As %DynamicArray, pUseSource As %Boolean, pKeyword As %String) As %Boolean
{
    Set tFound = 0
    For i = 1:1:pResult.%Size() {
        Set tHop = pResult.%Get(i - 1)
        Set tOID = $Select(pUseSource: tHop.OID, 1: tHop.TargetOID)
        If ..Label(tOID) [ pKeyword Set tFound = 1 Quit
    }
    Quit tFound
}

/// 打印单条断言结果
/// Print a single assertion result
ClassMethod report(pName As %String, pOK As %Boolean, ByRef pPass As %Boolean)
{
    Write "  [", $Select(pOK: "PASS", 1: "FAIL"), "] ", pName, !
    Set:'pOK pPass = 0
}

/// 清除本演示创建的所有测试数据（删除触发 Graph.Object.Index 清边）
/// Remove all test data created by this demo (deletion triggers Graph.Object.Index to clear edges)
ClassMethod Cleanup() As %Status
{
    // 两遍删除，规避一对多关系的删除顺序问题
    // Delete in two passes to avoid deletion-order issues with one-to-many relationships
    For tPass = 1:1:2 {
        Set tCls = ""
        For {
            Set tCls = $Order(^LogiDemo("obj", tCls))
            Quit:tCls=""
            Set tId = ""
            For {
                Set tId = $Order(^LogiDemo("obj", tCls, tId))
                Quit:tId=""
                Try {
                    Set tSC = $ClassMethod(tCls, "%DeleteId", tId)
                    Kill:$$$ISOK(tSC) ^LogiDemo("obj", tCls, tId)
                } Catch { }
            }
        }
    }
    Kill ^LogiDemo
    Quit $$$OK
}

